datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AccessDecisionType {
  ALLOW
  STEP_UP_VERIFICATION
  RESTRICT
  BLOCK
}

enum AuthEventType {
  LOGIN_ATTEMPT
  LOGIN_SUCCESS
  LOGIN_FAILURE
  OTP_REQUESTED
  OTP_VERIFIED
  OTP_FAILED
  OTP_EXPIRED
  LOGOUT
  REGISTER
  PASSWORD_CHANGE
  ADMIN_ACTION
  STEP_UP_REQUIRED
  ACCESS_DENIED
  SESSION_EXPIRED
}

enum SeverityLevel {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  otpChallenges      OTPChallenge[]
  devices            Device[]
  authEvents         AuthenticationEvent[]
  riskAssessments    RiskAssessment[]
  accessDecisions    AccessDecision[]
  auditLogs          SecurityAuditLog[]
  sessionRevocations SessionRevocation[]
  behavioralEvents   BehavioralEvent[]
  updatedPolicies    RiskPolicy[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model OTPChallenge {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  ipAddress  String
  userAgent  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id                String   @id @default(uuid())
  userId            String
  deviceFingerprint String
  userAgent         String
  ipAddress         String
  isKnown           Boolean  @default(true)
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  loginCount        Int      @default(1)

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  authEvents AuthenticationEvent[]

  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@index([deviceFingerprint])
}

model AuthenticationEvent {
  id             String              @id @default(uuid())
  userId         String
  eventType      AuthEventType
  success        Boolean
  ipAddress      String
  userAgent      String
  deviceId       String?
  riskScore      Decimal?            @db.Decimal(5, 2)
  riskLevel      RiskLevel?
  accessDecision AccessDecisionType?
  failureReason  String?
  createdAt      DateTime            @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  device          Device?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  riskAssessments RiskAssessment[]

  @@index([userId])
  @@index([eventType])
  @@index([riskLevel])
  @@index([createdAt])
  @@index([deviceId])
}

model RiskAssessment {
  id              String             @id @default(uuid())
  userId          String
  authEventId     String?
  riskScore       Decimal            @db.Decimal(5, 2)
  riskLevel       RiskLevel
  mlProbability   Decimal            @db.Decimal(5, 4)
  ruleBasedScore  Int
  accessDecision  AccessDecisionType
  explanation     Json
  features        Json
  modelVersion    String
  createdAt       DateTime           @default(now())

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  authEvent       AuthenticationEvent? @relation(fields: [authEventId], references: [id], onDelete: SetNull)
  accessDecisions AccessDecision[]

  @@index([userId])
  @@index([riskLevel])
  @@index([accessDecision])
  @@index([createdAt])
}

model AccessDecision {
  id               String             @id @default(uuid())
  userId           String
  riskAssessmentId String
  decision         AccessDecisionType
  policyVersion    Int                @default(1)
  evidence         Json
  explanation      String
  createdAt        DateTime           @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskAssessment RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([decision])
  @@index([createdAt])
}

model SecurityAuditLog {
  id           String        @id @default(uuid())
  userId       String?
  eventType    String
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String
  userAgent    String
  metadata     Json
  severity     SeverityLevel @default(INFO)
  createdAt    DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
}

model RiskPolicy {
  id          String   @id @default(uuid())
  name        String
  description String
  thresholds  Json
  weights     Json
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([version])
}

model SessionRevocation {
  id        String   @id @default(uuid())
  tokenJti  String   @unique
  userId    String
  revokedAt DateTime @default(now())
  reason    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenJti])
  @@index([userId])
}

model BehavioralEvent {
  id           String   @id @default(uuid())
  userId       String
  eventType    String
  metadata     Json
  ipAddress    String
  userAgent    String
  createdAt    DateTime @default(now())
  anomalyScore Decimal? @db.Decimal(5, 4)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}
